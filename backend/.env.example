PROJECT_NAME="Auto-Annotation Orchestrator"
API_V1_STR="/api/v1"

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY="replace-with-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM="HS256"

# Session-based Auth
SESSION_COOKIE_NAME="autoann_session"
SESSION_EXPIRE_MINUTES=1440
SESSION_ABSOLUTE_EXPIRE_DAYS=7
CSRF_SECRET_KEY="replace-with-random-csrf-secret-key"

# Database
# Example SQLite for local development:
SQLALCHEMY_DATABASE_URI="sqlite:///./autoann.db"
# Example Postgres:
# SQLALCHEMY_DATABASE_URI="postgresql+psycopg2://postgres:password@localhost:5432/autoannotation"

# CORS (comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:3000"

# Frontend URL (used in auth and email links)
FRONTEND_URL="http://localhost:3000"

# Google Auth (OIDC)
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Airflow
AIRFLOW_BASE_URL="http://localhost:8080"
AIRFLOW_TOKEN_SECRET_ID="airflow-default-token"

# Cloud Storage
GCS_BUCKET="replace-with-gcs-bucket"
GCS_UPLOAD_PREFIX="test_data"
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account-key.json"

# GCP Project (for Secret Manager)
GCP_PROJECT_ID="replace-with-gcp-project-id"

# Email (Postmark)
POSTMARK_SERVER_TOKEN="replace-with-postmark-server-token"
EMAIL_FROM_ADDRESS="noreply@example.com"
EMAIL_FROM_NAME="Auto-Annotation"
